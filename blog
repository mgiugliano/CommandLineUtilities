#!/usr/bin/env bash
#
# blog — manage posts for a Pandoc-based blog (see README for the repo
# layout it assumes).
#
# Usage:
#   blog                   Show help + status (default, no args)
#   blog new [title]       Draft a new post in content/posts/
#   blog edit [query]      Fuzzy-pick a post (fzf), open in $EDITOR, then
#                           tag it
#   blog tags [query]      Fuzzy-pick a post, then just do the tag step
#   blog delete [query]    Fuzzy-pick a post and delete it (rm, remove) --
#                          pushes the removal live too, if it was published
#   blog status            List posts not yet committed/pushed (check, pending)
#   blog push               Build, commit, and push pending posts   (publish)
#   blog help                Show this help only
#
# The post picker (edit/tags/delete) tags every entry with its status --
# untracked, modified, unpushed, or published -- so it's clear which posts
# are already live before you touch one.
#
# Tagging: `apfel` (Apple Intelligence from the command line — the on-device
# Foundation Models framework, https://apfel.franzai.com) reads the post and
# the blog's existing tag vocabulary and prints a quick hint — it never
# decides anything by itself. You then land on one editable prompt,
# pre-filled with that hint (or the post's current tags): press Enter to
# accept it as-is, or edit the line first. No fuzzy finder for tags — there's
# nothing to preview, and this makes "accept the proposal" a plain Enter.
#
# Assumes the repo looks like:
#   content/posts/*.md   posts, each with --- title / date / tags --- front
#                        matter (tags: a comma-separated list)
#   build.sh             builds the site (blog push runs it before committing)
#
# Config (env):
#   BLOG_REPO         Required. Path to your blog's working copy.
#   BLOG_SITE_URL      Optional. Shown in a couple of messages, e.g.
#                       https://blog.example.com — cosmetic only.
#   BLOG_TAG_SCHEMA    Optional. Path to the apfel JSON schema for tag
#                       output (default: ~/.bin/blog-tags.schema.json).
#
set -euo pipefail

REPO="${BLOG_REPO:?Set BLOG_REPO to the path of your blog repo working copy}"
POSTS_DIR="content/posts"
SITE_URL="${BLOG_SITE_URL:-}"
APFEL_SCHEMA="${BLOG_TAG_SCHEMA:-$HOME/.bin/blog-tags.schema.json}"

cd "$REPO" 2>/dev/null || { echo "❌ Repo not found: $REPO (check BLOG_REPO)" >&2; exit 1; }

# ---------- helpers ----------

slugify() {
  local s="$1"
  s="$(printf '%s' "$s" | tr -s '[:space:]' '-')"
  s="$(printf '%s' "$s" | sed -E 's/[^A-Za-z0-9-]//g')"
  s="$(printf '%s' "$s" | sed -E 's/-+/-/g')"
  s="$(printf '%s' "$s" | sed -E 's/^-//; s/-$//')"
  printf '%s' "$s"
}

# Read the `title:` front-matter value out of a post file, quotes stripped.
post_title() {
  local line
  line="$(grep -m1 '^title:' "$1" 2>/dev/null || true)"
  line="${line#title:}"
  line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  case "$line" in
    \"*\") line="${line#\"}"; line="${line%\"}" ;;
    \'*\') line="${line#\'}"; line="${line%\'}" ;;
  esac
  printf '%s' "$line"
}

# Classify one post's publish status against origin/main:
#   untracked | modified | unpushed | published
post_status() {
  local f="$1"
  if [ -n "$(git ls-files --others --exclude-standard -- "$f" 2>/dev/null)" ]; then
    echo "untracked"; return 0
  fi
  if [ -n "$(git diff --name-only -- "$f" 2>/dev/null)$(git diff --cached --name-only -- "$f" 2>/dev/null)" ]; then
    echo "modified"; return 0
  fi
  if [ -n "$(git log origin/main..HEAD --name-only --pretty=format: -- "$f" 2>/dev/null)" ]; then
    echo "unpushed"; return 0
  fi
  echo "published"
}

# Pick a post file: exact path/filename bypasses the picker; otherwise fuzzy-
# select with fzf (pre-filled with $1 as the query), falling back to a plain
# numbered prompt if fzf isn't installed. Prints the chosen path, or nothing.
resolve_post() {
  local query="${1:-}"

  if [ -n "$query" ] && [ -f "$query" ]; then
    printf '%s' "$query"; return 0
  fi
  if [ -n "$query" ] && [ -f "$POSTS_DIR/$query" ]; then
    printf '%s' "$POSTS_DIR/$query"; return 0
  fi

  local files
  files="$(find "$POSTS_DIR" -maxdepth 1 -name '*.md' 2>/dev/null | sort)"
  [ -z "$files" ] && { printf ''; return 0; }

  if command -v fzf >/dev/null 2>&1; then
    local chosen=""
    chosen="$(
      while IFS= read -r f; do
        printf '%s\t[%-9s] %s  —  %s\n' "$f" "$(post_status "$f")" "$(basename "$f")" "$(post_title "$f")"
      done <<< "$files" \
      | fzf --delimiter='\t' --with-nth=2 \
            --prompt="Post> " --query="$query" \
            --preview='bat --style=plain --color=always --language=markdown {1} 2>/dev/null || cat {1}' \
            --preview-window=right:60%,wrap \
      | cut -f1
    )" || chosen=""
    printf '%s' "$chosen"
    return 0
  fi

  local matches
  if [ -n "$query" ]; then
    matches="$(while IFS= read -r f; do
      case "$(basename "$f") $(post_title "$f")" in
        *"$query"*) echo "$f" ;;
      esac
    done <<< "$files")"
  else
    matches="$files"
  fi
  [ -z "$matches" ] && { printf ''; return 0; }

  local count
  count="$(printf '%s\n' "$matches" | sed '/^$/d' | wc -l | tr -d ' ')"
  if [ "$count" = "1" ]; then
    printf '%s' "$matches"; return 0
  fi

  echo "Multiple matches — install 'fzf' for a picker, or narrow your query:" >&2
  local i=1
  while IFS= read -r f; do
    printf '  %d) [%-9s] %-45s %s\n' "$i" "$(post_status "$f")" "$(basename "$f")" "$(post_title "$f")" >&2
    i=$((i+1))
  done <<< "$matches"
  local pick=""
  read -rp "Pick a number: " pick || true
  printf '%s' "$(printf '%s\n' "$matches" | sed -n "${pick}p")"
}

# Deduplicated, lowercase, comma-joined tag vocabulary across all posts.
all_tags_vocab() {
  grep -h '^tags:' "$POSTS_DIR"/*.md 2>/dev/null \
    | sed 's/^tags:[[:space:]]*//' \
    | tr ',' '\n' \
    | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
    | tr '[:upper:]' '[:lower:]' \
    | sed '/^$/d' \
    | sort -u \
    | paste -sd, -
}

# Rewrite the `tags:` line in a post's front matter (adds one if missing).
apply_tags() {
  local file="$1" new_tags="$2"
  python3 - "$file" "$new_tags" << 'PYEOF'
import sys, re
file_path, new_tags = sys.argv[1], sys.argv[2]
with open(file_path, encoding='utf-8') as f:
    content = f.read()
if content.startswith('---'):
    parts = content.split('---', 2)
    if len(parts) >= 3:
        front = parts[1]
        if re.search(r'(?m)^tags:.*$', front):
            front = re.sub(r'(?m)^tags:.*$', f'tags: {new_tags}', front, count=1)
        else:
            front = front.rstrip('\n') + f'\ntags: {new_tags}\n'
        content = '---' + front + '---' + parts[2]
with open(file_path, 'w', encoding='utf-8') as f:
    f.write(content)
PYEOF
}

# Set/replace a post's `thumbnail:` front-matter field.
apply_thumbnail_field() {
  local file="$1" thumb_path="$2"
  python3 - "$file" "$thumb_path" << 'PYEOF'
import sys, re
file_path, thumb_path = sys.argv[1], sys.argv[2]
with open(file_path, encoding='utf-8') as f:
    content = f.read()
if content.startswith('---'):
    parts = content.split('---', 2)
    if len(parts) >= 3:
        front = parts[1]
        if re.search(r'(?m)^thumbnail:.*$', front):
            front = re.sub(r'(?m)^thumbnail:.*$', f'thumbnail: {thumb_path}', front, count=1)
        else:
            front = front.rstrip('\n') + f'\nthumbnail: {thumb_path}\n'
        content = '---' + front + '---' + parts[2]
with open(file_path, 'w', encoding='utf-8') as f:
    f.write(content)
PYEOF
}

# Record where a fetched thumbnail came from as an HTML comment right after
# the front matter — invisible when rendered, kept in source as a paper
# trail. Does NOT by itself satisfy a CC-BY/CC-BY-SA license's requirement
# for visible attribution; see the caller's warning for that.
add_image_credit() {
  local file="$1" page_url="$2" license="$3" artist="$4"
  python3 - "$file" "$page_url" "$license" "$artist" << 'PYEOF'
import sys
file_path, page_url, license_, artist = sys.argv[1:5]
with open(file_path, encoding='utf-8') as f:
    content = f.read()
credit = f'<!-- Thumbnail source: {page_url} ({license_}'
if artist:
    credit += f', by {artist}'
credit += ') -->\n'
if content.startswith('---'):
    parts = content.split('---', 2)
    if len(parts) >= 3:
        content = '---' + parts[1] + '---\n' + credit + parts[2].lstrip('\n')
with open(file_path, 'w', encoding='utf-8') as f:
    f.write(content)
PYEOF
}

# Tag a post: `apfel` (Apple's on-device model) prints a quick hint, then the
# user is dropped into a single editable prompt pre-filled with that hint
# (or the post's current tags) — press Enter to accept it as-is, or edit
# the line first. No fuzzy finder here: tags aren't files, there's nothing
# meaningful to preview, and a plain editable line makes "accept the
# proposal" unambiguous (just press Enter).
suggest_tags_for() {
  local file="$1"
  local vocab current_tags
  vocab="$(all_tags_vocab)"
  current_tags="$(grep -m1 '^tags:' "$file" 2>/dev/null | sed 's/^tags:[[:space:]]*//')"

  local hint=""
  if command -v apfel >/dev/null 2>&1; then
    echo "🏷️  Extracting candidate tags from $(basename "$file") (apfel, on-device)..."
    # Strip front matter first — otherwise apfel just parrots back whatever
    # tags: line is already there instead of reading the post fresh.
    local stripped raw
    stripped="$(mktemp)"
    python3 -c "
import re
with open('$file', encoding='utf-8') as f:
    content = f.read()
title, body = '', content
if content.startswith('---'):
    parts = content.split('---', 2)
    if len(parts) >= 3:
        m = re.search(r'(?m)^title:\s*(.*)\$', parts[1])
        title = m.group(1).strip().strip('\"\'') if m else ''
        body = parts[2].strip()
print(f'Title: {title}\n\n{body}')
" > "$stripped"

    if raw="$(apfel -q -o json --temperature 0 \
        --schema "$APFEL_SCHEMA" \
        -s "Task: tag-selection, no explanations. Given a tag vocabulary and a blog post, choose at most 5 lowercase tags from the vocabulary; invent a new one only if nothing existing fits." \
        -f "$stripped" \
        "Vocabulary: $vocab" 2>/tmp/blog-apfel-err.log)"; then
      hint="$(printf '%s' "$raw" | python3 -c "
import json, sys
try:
    outer = json.load(sys.stdin)
    tags = json.loads(outer['content'])['tags']
    print(', '.join(tags))
except Exception:
    pass
")"
    else
      echo "⚠️  apfel tag extraction failed — continuing without a hint." >&2
    fi
    rm -f "$stripped"
  else
    echo "⚠️  'apfel' not found (brew install apfel) — continuing without a hint." >&2
  fi

  echo ""
  echo "Existing tags across the blog: ${vocab//,/, }"
  echo "Current tags:   ${current_tags:-<none>}"
  [ -n "$hint" ] && echo "Model suggests: $hint"
  echo ""

  local prefill="${hint:-$current_tags}"
  local new_tags=""
  read -e -i "$prefill" -rp "Tags (edit as needed, Enter to accept): " new_tags || true

  if [ -z "$new_tags" ]; then
    echo "No tags entered — left unchanged."
    return 0
  fi
  if [ "$new_tags" = "$current_tags" ]; then
    echo "Tags unchanged."
    return 0
  fi

  apply_tags "$file" "$new_tags"
  echo "✓ Tags updated: $new_tags"
}

# ---------- subcommands ----------

cmd_new() {
  local title="$*"
  if [ -z "$title" ]; then
    read -rp "Post title: " title || true
  fi
  if [ -z "$title" ]; then
    echo "❌ A title is required." >&2
    exit 1
  fi

  local today slug filename
  today="$(date +%Y-%m-%d)"
  slug="$(slugify "$title")"
  filename="$POSTS_DIR/${today}-${slug}.md"

  if [ -e "$filename" ]; then
    echo "❌ $filename already exists — pick a different title, or edit it directly." >&2
    exit 1
  fi

  local title_yaml="$title"
  case "$title" in
    *:*|*\"*) title_yaml="\"${title//\"/\\\"}\"" ;;
  esac

  mkdir -p "$POSTS_DIR"
  cat > "$filename" << EOF
---
title: $title_yaml
date: $today
tags:
---

Write your opening paragraph here.
EOF

  # Separate, quoted (literal) heredoc for the reminder block — it contains
  # raw \$ and \`\`\` that must NOT be touched by shell expansion, unlike
  # the front matter above.
  cat >> "$filename" << 'REMINDER'

<!--
  Formatting reminders — delete this comment block before publishing.

  Link:
    [link text](https://example.com)

  Image (drop the file into static/images/ first, see static/images/README.md):
    ![Caption describing the image](/static/images/your-file.jpg)

  Equation, inline (LaTeX via MathJax):
    the membrane time constant $\tau_m = R_m C_m$

  Equation, display:
    $$
    C_m \frac{dV}{dt} = -\frac{V - V_{rest}}{R_m} + I(t)
    $$

  Code:
    ```python
    def spike_times(v, threshold):
        return [t for t, x in enumerate(v) if x > threshold]
    ```
-->
REMINDER

  echo "📝 Created $filename"

  if [ -n "${EDITOR:-}" ]; then
    $EDITOR "$filename"
  else
    echo "   (no \$EDITOR set — open it yourself when ready)"
  fi

  echo ""
  echo "Next: fill in tags + content, preview with ./build.sh, then 'blog status' / 'blog push'."
}

cmd_edit() {
  local file
  file="$(resolve_post "$*")"
  if [ -z "$file" ]; then
    echo "No post selected."
    return 0
  fi

  echo "✏️  Editing $file"
  if [ -n "${EDITOR:-}" ]; then
    $EDITOR "$file"
  else
    echo "❌ \$EDITOR is not set — open $file yourself." >&2
    return 1
  fi

  echo ""
  suggest_tags_for "$file"
}

cmd_tags() {
  local file
  file="$(resolve_post "$*")"
  if [ -z "$file" ]; then
    echo "No post selected."
    return 0
  fi
  suggest_tags_for "$file"
}

# Search Wikimedia Commons (free, no API key, CC-licensed) for a post's
# thumbnail, download the pick into static/images/, and set thumbnail: in
# its front matter. Nothing is auto-picked — you always choose from a list.
cmd_thumbnail() {
  local file
  file="$(resolve_post "$*")"
  if [ -z "$file" ]; then
    echo "No post selected."
    return 0
  fi

  local title slug results_file
  title="$(post_title "$file")"
  slug="$(basename "$file" .md)"
  results_file="$(mktemp)"
  # shellcheck disable=SC2064
  trap "rm -f '$results_file'" RETURN

  local pick="" count=0
  while true; do
    local search=""
    read -e -i "$title" -rp "Search Wikimedia Commons for: " search || true
    if [ -z "$search" ]; then
      echo "Cancelled."
      return 0
    fi

    echo "🔎 Searching Wikimedia Commons for \"$search\"..."
    if ! python3 - "$search" "$results_file" << 'PYEOF'
import sys, json, re, urllib.request, urllib.parse

query, out_path = sys.argv[1], sys.argv[2]
base = "https://commons.wikimedia.org/w/api.php"

def api_get(params):
    url = base + "?" + urllib.parse.urlencode(params) + "&format=json"
    req = urllib.request.Request(url, headers={"User-Agent": "blog-cli/1.0 (personal blog tool)"})
    with urllib.request.urlopen(req, timeout=15) as resp:
        return json.load(resp)

results = []
search_data = api_get({
    "action": "query", "list": "search",
    "srsearch": query, "srnamespace": "6", "srlimit": "8",
})
titles = [r["title"] for r in search_data.get("query", {}).get("search", [])]
if titles:
    info_data = api_get({
        "action": "query", "titles": "|".join(titles),
        "prop": "imageinfo", "iiprop": "url|extmetadata", "iiurlwidth": "800",
    })
    pages = info_data.get("query", {}).get("pages", {})
    for t in titles:
        page = next((p for p in pages.values() if p.get("title") == t), None)
        if not page or "imageinfo" not in page:
            continue
        info = page["imageinfo"][0]
        meta = info.get("extmetadata", {})
        license_short = meta.get("LicenseShortName", {}).get("value", "unknown")
        artist = re.sub(r'<[^>]+>', '', meta.get("Artist", {}).get("value", "")).strip()
        results.append({
            "title": t.replace("File:", ""),
            "thumb": info.get("thumburl") or info.get("url", ""),
            "page": info.get("descriptionurl", ""),
            "license": license_short,
            "artist": artist,
        })
# CC0 / public domain first — no attribution obligation
results.sort(key=lambda r: 0 if 'cc0' in r["license"].lower() or 'public domain' in r["license"].lower() else 1)
with open(out_path, 'w', encoding='utf-8') as f:
    json.dump(results, f)
PYEOF
    then
      echo "⚠️  Search request failed — check your connection and try again."
      continue
    fi

    count="$(python3 -c "import json; print(len(json.load(open('$results_file'))))")"
    if [ "$count" = "0" ]; then
      echo "No results — try different search terms."
      continue
    fi

    echo ""
    python3 -c "
import json
for i, r in enumerate(json.load(open('$results_file')), 1):
    artist = f' — {r[\"artist\"]}' if r['artist'] else ''
    print(f'  {i}) [{r[\"license\"]}]{artist}  {r[\"title\"]}')
    print(f'     {r[\"page\"]}')
"
    echo ""
    read -rp "Pick a number to use (open the URL above to preview first), 'r' to search again, or Enter to cancel: " pick || true

    case "$pick" in
      "") echo "Cancelled."; return 0 ;;
      r|R) continue ;;
      *[!0-9]*) echo "Invalid choice."; continue ;;
      *)
        if [ "$pick" -lt 1 ] || [ "$pick" -gt "$count" ]; then
          echo "Invalid choice."
          continue
        fi
        break
        ;;
    esac
  done

  echo "⬇️  Downloading..."
  local download_result
  download_result="$(python3 - "$results_file" "$pick" "static/images" "$slug" << 'PYEOF'
import sys, json, urllib.request
from urllib.parse import urlparse

results_path, pick, img_dir, slug = sys.argv[1], int(sys.argv[2]) - 1, sys.argv[3], sys.argv[4]
r = json.load(open(results_path))[pick]

# Extension from the URL *path* only -- the query string (tracking params
# like utm_source=commons.wikimedia.org) has dots of its own and will
# mislead a naive rsplit('.') on the full URL.
path_only = urlparse(r['thumb']).path
ext = path_only.rsplit('.', 1)[-1].lower() if '.' in path_only else ''
if len(ext) > 4 or not ext.isalnum():
    ext = 'jpg'
dest_rel = f'{img_dir}/{slug}-thumb.{ext}'

req = urllib.request.Request(r['thumb'], headers={'User-Agent': 'blog-cli/1.0'})
with urllib.request.urlopen(req, timeout=30) as resp:
    data = resp.read()
with open(dest_rel, 'wb') as f:
    f.write(data)

print('\t'.join([dest_rel, r['license'], r['artist'], r['page'], r['title']]))
PYEOF
)"
  if [ -z "$download_result" ]; then
    echo "❌ Download failed." >&2
    return 1
  fi

  local dest_rel img_license img_artist img_page img_title
  IFS=$'\t' read -r dest_rel img_license img_artist img_page img_title <<< "$download_result"

  apply_thumbnail_field "$file" "/$dest_rel"
  add_image_credit "$file" "$img_page" "$img_license" "$img_artist"

  echo "✓ Saved $dest_rel and set thumbnail: in $(basename "$file")"
  case "$(printf '%s' "$img_license" | tr '[:upper:]' '[:lower:]')" in
    *cc0*|*public\ domain*) : ;;
    *)
      echo "⚠️  This image is \"$img_license\" — that license requires visible"
      echo "   attribution when published, not just the HTML comment I added."
      echo "   Consider a visible credit line, or pick a CC0/Public Domain result instead."
      ;;
  esac
}

cmd_status() {
  echo "🔎 Checking $POSTS_DIR against origin/main..."
  git fetch --quiet origin main 2>/dev/null \
    || echo "⚠️  Could not reach GitHub — 'unpushed commit' status may be stale."

  local untracked modified unpushed pending
  untracked="$(git ls-files --others --exclude-standard -- "$POSTS_DIR" 2>/dev/null || true)"
  modified="$( { git diff --name-only -- "$POSTS_DIR"; git diff --cached --name-only -- "$POSTS_DIR"; } 2>/dev/null | sort -u)"
  unpushed="$(git log origin/main..HEAD --name-only --pretty=format: -- "$POSTS_DIR" 2>/dev/null | sed '/^$/d' | sort -u)"

  pending="$(printf '%s\n%s\n%s\n' "$untracked" "$modified" "$unpushed" | sed '/^$/d' | sort -u)"

  if [ -z "$pending" ]; then
    echo "✅ Everything in $POSTS_DIR is committed and pushed."
    return 0
  fi

  echo ""
  printf '%-52s %-10s %s\n' "FILE" "STATUS" "TITLE"
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    local status title
    if printf '%s\n' "$untracked" | grep -qxF "$f"; then
      status="untracked"
    elif printf '%s\n' "$modified" | grep -qxF "$f"; then
      status="modified"
    else
      status="unpushed"
    fi
    title="$(post_title "$f")"
    [ -z "$title" ] && title="?"
    printf '%-52s %-10s %s\n' "$f" "$status" "$title"
  done <<< "$pending"
}

cmd_push() {
  cmd_status
  echo ""

  local staged_files ahead
  staged_files="$(git status --porcelain -- "$POSTS_DIR" 2>/dev/null | awk '{print $2}')"
  ahead="$(git log origin/main..HEAD --name-only --pretty=format: -- "$POSTS_DIR" 2>/dev/null | sed '/^$/d')"

  if [ -z "$staged_files" ] && [ -z "$ahead" ]; then
    echo "Nothing to push."
    return 0
  fi

  if [ -n "$staged_files" ]; then
    echo "🔨 Building locally to check for errors..."
    if ! ./build.sh > /tmp/blog-build.log 2>&1; then
      echo "❌ Build failed — see /tmp/blog-build.log" >&2
      exit 1
    fi
    echo "✓ Build OK"

    # shellcheck disable=SC2086
    git add $staged_files

    local titles msg count
    titles="$(for f in $staged_files; do post_title "$f"; done | paste -sd, -)"
    count="$(printf '%s\n' "$staged_files" | sed '/^$/d' | wc -l | tr -d ' ')"
    if [ "$count" = "1" ]; then
      msg="Publish post: ${titles}"
    else
      msg="Publish posts: ${titles}"
    fi

    read -rp "Commit message [$msg]: " custom_msg || true
    [ -n "${custom_msg:-}" ] && msg="$custom_msg"

    git commit -m "$msg"
  fi

  local confirm=""
  read -rp "Push to GitHub now? [y/N] " confirm || true
  case "$confirm" in
    y|Y) push_and_watch ;;
    *) echo "Not pushed — commit(s) stayed local. Run 'blog push' again when ready."; return 0 ;;
  esac
}

# Push to origin/main and watch the GitHub Actions deploy, if `gh` is around.
push_and_watch() {
  git push origin main

  echo "🚀 Pushed. Watching GitHub Actions deploy..."
  if command -v gh >/dev/null 2>&1; then
    sleep 5
    local run_id
    run_id="$(gh run list --limit 1 --json databaseId --jq '.[0].databaseId' 2>/dev/null || true)"
    if [ -n "$run_id" ] && gh run watch "$run_id" --exit-status; then
      echo "✅ Deployed.${SITE_URL:+ $SITE_URL/blog.html}"
    else
      echo "⚠️  Couldn't confirm the deploy — check: gh run list"
    fi
  else
    echo "(install 'gh' to auto-watch the deploy; otherwise check the Actions tab)"
  fi
}

# Delete a post: git-rm it (or plain rm if it was never tracked), rebuild to
# confirm the site still builds, commit, then — only if it was actually
# live — ask before pushing the removal out to the real site.
cmd_delete() {
  local file
  file="$(resolve_post "$*")"
  if [ -z "$file" ]; then
    echo "No post selected."
    return 0
  fi

  local status title
  status="$(post_status "$file")"
  title="$(post_title "$file")"
  [ -z "$title" ] && title="$(basename "$file")"

  echo "About to delete: $file"
  echo "  Title:  $title"
  echo "  Status: $status"
  case "$status" in
    published) echo "  ⚠️  This post is live — deleting it will need a push to take it down." ;;
    unpushed)  echo "  This post is committed locally but not yet on GitHub." ;;
    modified)  echo "  This post has uncommitted edits." ;;
  esac

  local confirm=""
  read -rp "Delete this post? [y/N] " confirm || true
  case "$confirm" in
    y|Y) ;;
    *) echo "Not deleted."; return 0 ;;
  esac

  if [ "$status" = "untracked" ]; then
    rm -f "$file"
    echo "🗑️  Deleted (it was never committed)."
    return 0
  fi

  git rm -q "$file"
  echo "🗑️  Removed from git: $file"

  echo ""
  echo "🔨 Building locally to confirm the site still builds cleanly..."
  if ! ./build.sh > /tmp/blog-build.log 2>&1; then
    echo "❌ Build failed after deletion — see /tmp/blog-build.log" >&2
    echo "   The removal is staged but not committed; fix the build, or 'git reset' to undo." >&2
    exit 1
  fi
  echo "✓ Build OK"

  local msg="Remove post: $title"
  read -rp "Commit message [$msg]: " custom_msg || true
  [ -n "${custom_msg:-}" ] && msg="$custom_msg"
  git commit -q -m "$msg"
  echo "✓ Committed."

  if [ "$status" = "published" ]; then
    local push_confirm=""
    read -rp "Push now, to actually remove it from the live site? [y/N] " push_confirm || true
    case "$push_confirm" in
      y|Y) push_and_watch ;;
      *) echo "Committed locally only — run 'blog push' when ready to take it down live." ;;
    esac
  else
    echo "Committed locally. Run 'blog push' when ready to push."
  fi
}

cmd_help() {
  cat << EOF
blog — manage posts for a Pandoc-based blog${SITE_URL:+ ($SITE_URL)}

Usage:
  blog                    Show this help + 'blog status' (no args)
  blog new [title]        Draft a new post in $POSTS_DIR/
  blog edit [query]        Fuzzy-pick a post (fzf), edit in \$EDITOR, then tag it
  blog tags [query]        Fuzzy-pick a post and just do the tag step
  blog thumbnail [query]    Fuzzy-pick a post and fetch a thumbnail for it
                             from Wikimedia Commons (thumb, image)
  blog delete [query]        Fuzzy-pick a post and delete it (rm, remove) —
                              pushes the removal live too, if it was published
  blog status                List posts not yet committed/pushed  (check, pending)
  blog push                  Build, commit, and push pending posts (publish)
  blog help                   Show this help only

The post picker (edit/tags/delete) tags every entry with its status:
untracked, modified, unpushed, or published — so it's clear which posts
are already live before you touch one.
EOF
}

case "${1:-__default__}" in
  new) shift; cmd_new "$@" ;;
  edit) shift; cmd_edit "$@" ;;
  tags) shift; cmd_tags "$@" ;;
  thumbnail|thumb|image) shift; cmd_thumbnail "$@" ;;
  delete|rm|remove) shift; cmd_delete "$@" ;;
  status|check|pending) cmd_status ;;
  push|publish) cmd_push ;;
  help|-h|--help) cmd_help ;;
  __default__) cmd_help; echo ""; cmd_status ;;
  *) echo "Unknown command: $1" >&2; echo ""; cmd_help; exit 1 ;;
esac
